# Copy this file to .release.env on the protected release Mac. It is ignored
# by Git and supplies non-secret release selectors to scripts/release.sh.
#
# NEVER put a private key, .p12 password, Apple ID password, API key, token,
# or notarization credential in this file. The signing private key and the
# notarytool credentials stay in the macOS Keychain.

export JORT_RELEASE_IDENTITY="0123456789ABCDEF0123456789ABCDEF01234567"
export JORT_RELEASE_TEAM_ID="ABCDE12345"
# $PWD and ${PWD} resolve to this repository's root directory only.
export JORT_RELEASE_PROVISIONING_PROFILE="$PWD/Jort.provisionprofile"
export JORT_RELEASE_NOTARY_PROFILE="jort-release"
export JORT_RELEASE_ARCHITECTURE="arm64"
