{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jort.dev/schemas/release-manifest-v1.json",
  "title": "Jort immutable release manifest v1",
  "type": "object",
  "required": ["schemaVersion", "configuration", "production", "version", "build", "objects", "files", "symlinks", "directories", "systemDependencyRoots", "forbiddenPaths", "projectSHA256", "generatedProjectSHA256", "policySHA256", "sourceRevision", "toolchain", "xcodegen", "provisioningProfile"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": 1},
    "configuration": {"const": "Release"},
    "production": {"type": "boolean"},
    "version": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)*$"},
    "build": {"type": "string", "pattern": "^[0-9]+$"},
    "sourceRevision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "projectSHA256": {"$ref": "#/$defs/hash"},
    "generatedProjectSHA256": {"$ref": "#/$defs/hash"},
    "policySHA256": {"$ref": "#/$defs/hash"},
    "toolchain": {"type": "string"},
    "xcodegen": {"type": "string"},
    "provisioningProfile": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/provisioningProfile"}]},
    "systemDependencyRoots": {"const": ["/System/Library/", "/usr/lib/"]},
    "forbiddenPaths": {"type": "array", "items": {"type": "string"}},
    "symlinks": {"type": "object", "additionalProperties": {"type": "string"}},
    "directories": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "files": {"type": "object", "additionalProperties": {"$ref": "#/$defs/file"}},
    "objects": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/code"}}
  },
  "$defs": {
    "provisioningProfile": {
      "type": "object", "additionalProperties": false,
      "required": ["sha256", "teamID", "environment", "platform", "signingCertificateSHA1", "applicationIdentifier", "keychainAccessGroup", "expiration", "uuid", "name"],
      "properties": {
        "sha256": {"$ref": "#/$defs/hash"}, "teamID": {"type": "string", "pattern": "^[A-Z0-9]{10}$"},
        "environment": {"enum": ["development", "production"]}, "platform": {"const": "OSX"}, "signingCertificateSHA1": {"type": "string", "pattern": "^[0-9A-F]{40}$"},
        "applicationIdentifier": {"type": "string"}, "keychainAccessGroup": {"type": "string"},
        "expiration": {"type": "string", "format": "date-time"}, "uuid": {"type": "string"}, "name": {"type": "string"}
      }
    },
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {
      "type": "object", "required": ["kind", "mode"],
      "properties": {
        "kind": {"enum": ["code", "resource", "plist"]},
        "mode": {"enum": [420, 493]},
        "source": {"type": "string"},
        "sha256": {"$ref": "#/$defs/hash"},
        "plist": {"type": "object"},
        "values": {"type": "object"}
      }, "additionalProperties": false
    },
    "code": {
      "type": "object",
      "required": ["target", "path", "parent", "role", "identifier", "executable", "executableMode", "architectures", "infoPlist", "infoValues", "teamID", "hardenedRuntime", "entitlements", "quickjs", "dependencies", "runpaths", "entitlementInput", "entitlementSHA256", "peerRequirements"],
      "properties": {
        "target": {"type": "string"}, "path": {"type": "string"},
        "parent": {"type": ["string", "null"]},
        "role": {"enum": ["app", "framework", "broker", "worker"]},
        "identifier": {"type": "string"}, "executable": {"type": "string"},
        "executableMode": {"const": 493},
        "architectures": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["arm64", "x86_64"]}},
        "infoPlist": {"type": ["string", "null"]}, "infoValues": {"type": "object"},
        "teamID": {"type": ["string", "null"]}, "hardenedRuntime": {"const": true},
        "entitlements": {"type": "object"}, "quickjs": {"type": "boolean"},
        "peerRequirements": {"type": "array", "uniqueItems": true, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["edge", "peerTarget", "teamRelation", "requirementTemplate"],
          "properties": {
            "edge": {"enum": ["app-to-broker", "broker-to-app", "broker-to-worker"]},
            "peerTarget": {"enum": ["Jort", "JortJavaScriptBroker", "JortJavaScriptWorker"]},
            "teamRelation": {"const": "self"},
            "requirementTemplate": {"type": "string"}
          }
        }},
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "runpaths": {"type": "array", "items": {"type": "string"}},
        "entitlementInput": {"type": ["string", "null"]},
        "entitlementSHA256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]}
      }, "additionalProperties": false
    }
  }
}
