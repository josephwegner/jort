+void JS_DisableEval(JSContext *ctx)
+{
+    ctx->eval_internal = NULL;
+}
+
+int JS_IsToolModule(JSValueConst value)
+{
+    if (JS_VALUE_GET_TAG(value) != JS_TAG_MODULE)
+        return 0;
+    JSModuleDef *module = JS_VALUE_GET_PTR(value);
+    if (module->req_module_entries_count != 0)
+        return 0;
+    for (int i = 0; i < module->export_entries_count; i++) {
+        if (module->export_entries[i].export_name == JS_ATOM_default)
+            return 1;
+    }
+    return 0;
+}
