{
  "schemaVersion": 3,
  "executor": "javascript",
  "id": "dev.jort.random",
  "version": 1,
  "name": "Random",
  "command": "/random",
  "description": "Generate a random alphanumeric string.",
  "entryContract": 2,
  "inputMode": "contained",
  "outputOperation": "replace-invocation",
  "maximumInputBytes": 262144,
  "maximumOutputBytes": 262144,
  "maximumOutputLines": 10000,
  "capturedData": [
    "entropy"
  ],
  "arguments": [
    {
      "name": "length",
      "type": "integer",
      "label": "Number of characters",
      "description": "Enter how many characters to generate.",
      "defaultValue": 12,
      "minimum": 1,
      "maximum": 4096
    }
  ]
}
